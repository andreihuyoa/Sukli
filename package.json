{
  "name": "suki-monorepo",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile:start": "npm run -w @suki/mobile start",
    "mobile:android": "npm run -w @suki/mobile android",
    "mobile:lint": "npm run -w @suki/mobile lint",
    "backend:dev": "npm run -w @suki/backend dev",
    "backend:build": "npm run -w @suki/backend build",
    "backend:start": "npm run -w @suki/backend start"
  },
  "devDependencies": {
    "eslint-config-prettier": "^10.1.8",
    "prettier": "3.8.1"
  }
}
