{
  "name": "sukli-monorepo",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile:start": "npm run -w @sukli/mobile start",
    "mobile:lint": "npm run -w @sukli/mobile lint",
    "backend:dev": "npm run -w @sukli/backend dev",
    "backend:build": "npm run -w @sukli/backend build",
    "backend:start": "npm run -w @sukli/backend start",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,md,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "eslint-config-prettier": "^10.1.8",
    "expo-router": "~57.0.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "3.8.1"
  },
  "optionalDependencies": {
    "@unrs/resolver-binding-darwin-arm64": "^1.11.1"
  }
}
