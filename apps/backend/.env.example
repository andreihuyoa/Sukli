# Server
PORT=4000
ENVIRONMENT=development

# Supabase
SUPABASE_URL=https://ffvxtyfvtsbvspqszpfd.supabase.co

# Postgres (via Supabase session-mode pooler — IPv4, works on all machines)
#
# Steps to get the correct URL:
#   1. Supabase Dashboard → Settings → Database
#   2. Copy "Session mode" connection string (port 5432)  ← use this
#   3. URL-encode special chars in password: @ → %40, # → %23, $ → %24
#
# Username format for pooler: postgres.<project-ref>  (NOT just "postgres")
# Region example: aws-0-ap-southeast-1, aws-0-us-east-1, aws-0-eu-west-1
#
# Direct URL (db.<ref>.supabase.co) may be IPv6-only; avoid for local dev.
DATABASE_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# CORS — comma-separated origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081
