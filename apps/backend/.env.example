PORT=4000
ENVIRONMENT=development

SUPABASE_URL=https://<project-ref>.supabase.co

# Anon key — Dashboard → Settings → API → anon / public
SUPABASE_ANON_KEY=
# Service Role key — Dashboard → Settings → API → service_role   (NEVER commit)
SUPABASE_SERVICE_ROLE_KEY=
# JWT secret — Dashboard → Settings → API → JWT Settings
SUPABASE_JWT_SECRET=

DATABASE_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081
